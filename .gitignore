.claude/
node_modules/
dist/
.DS_Store
*.log
3dmodel/**/model_raw.glb

# Secret : clé partagée avec le serveur de paiement, jamais versionnée
paiement.config.json

# Certificat de la borne iPad : contient une CLÉ PRIVÉE, jamais versionnée.
# Il se refabrique tout seul au lancement de « npm run ipad ».
certs/

# Secret : clé partagée avec le serveur de dossiers, jamais versionnée
serveur.config.json

# SDK Visage : logiciel propriétaire sous licence d'évaluation. Le dépôt est
# public, le redistribuer violerait le contrat (art. 5.3). La clé de licence
# (.vlc) est un secret. Ni l'un ni l'autre ne sont versionnés.
sdk-visage/
*.vlc

# Identite d une borne : propre a chaque machine, jamais versionnee
borne.json

# Lien symbolique créé pour les bancs du serveur : il a fait échouer la publication GitHub Pages.
# (« node_modules/ » seul ne désigne que les dossiers, pas un lien.)
serveur/node_modules
