{
  "name": "optique-noe",
  "version": "1.0.0",
  "description": "N.O.A — Essayage Virtuel de Lunettes",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.noa.optique",
    "productName": "NOA Optique",
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!*.md"
    ]
  },
  "dependencies": {
    "@mediapipe/face_mesh": "0.4.1633559619",
    "three": "0.160.0"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0"
  }
}
