# Copier en .env, remplir, et NE JAMAIS versionner ce fichier.
# Générer les secrets avec :  openssl rand -base64 36

# Nom de domaine du serveur (enregistrement A vers l'IP de la machine Hetzner)
NOA_DOMAINE=noa.exemple.sn

# Secret partagé avec les bornes : à recopier dans serveur.config.json de CHAQUE borne
NOA_CLE_BORNE=

# ── Comptes du tableau de bord (nom d'utilisateur + mot de passe) ──
# Deux rôles : admin (tout) et opticien (dossiers ; peut être limité à une boutique).
# Mode simple, pour démarrer : un administrateur (mot de passe de 12 caractères au moins).
NOA_ADMIN_UTILISATEUR=
NOA_ADMIN_MDP=
# Mode recommandé : plusieurs comptes, mots de passe jamais en clair. Chaque ligne se fabrique avec
#   docker compose exec -e NOA_NOUVEAU_MDP='le mot de passe' noa node outils/creer-compte.js fred opticien dakar-plateau
# puis se colle ici, les comptes séparés par « ; » (le 3e champ, la boutique, est facultatif) :
#   NOA_COMPTES=bayla:admin:scrypt.xxxx.yyyy;fred:opticien:scrypt.xxxx.yyyy:dakar-plateau
NOA_COMPTES=
# Ancien dispositif (un seul mot de passe partagé) : laisser vide.
NOA_MDP_ATELIER=

# Origine(s) autorisée(s) à appeler l'API depuis un navigateur (le tableau de bord).
# Plusieurs : séparées par des virgules.
NOA_ORIGINES=https://bayla-amadou.github.io

# Jours de conservation des photos après la livraison
NOA_PURGE_JOURS=30
