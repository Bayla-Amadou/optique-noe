# Copier en .env, remplir, et NE JAMAIS versionner ce fichier.
# Générer les secrets avec :  openssl rand -base64 36

# Nom de domaine du serveur (enregistrement A vers l'IP de la machine Hetzner)
NOA_DOMAINE=noa.exemple.sn

# Secret partagé avec les bornes : à recopier dans serveur.config.json de CHAQUE borne
NOA_CLE_BORNE=

# Mot de passe de l'atelier (connexion au tableau de bord). 20 caractères au moins.
NOA_MDP_ATELIER=

# Origine(s) autorisée(s) à appeler l'API depuis un navigateur (le tableau de bord).
# Plusieurs : séparées par des virgules.
NOA_ORIGINES=https://bayla-amadou.github.io

# Jours de conservation des photos après la livraison
NOA_PURGE_JOURS=30
